#Using the scaled iPRS and Hypertension Score 


model_HT <- lm(multiancestry_PRS_scaled ~ SCORE_HYPERTENSION, data = joined_df_cv401)
summary(model_HT)

joined_df_cv401$resid_SCORE <- residuals(model_HT)
head(joined_df_cv401)
model_final <- glm(hypertension_score_case_control_binary ~ resid_SCORE + SCORE_HYPERTENSION,
                   data = joined_df_cv401 ,
                   family = "binomial")  # Logistic regression
summary(model_final)

