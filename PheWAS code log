######################################### Creating file for PRS generation #########################################


# Read the file as a data frame
snp_list <- read.table("~/Downloads/iPRS-M.txt", header = T, sep = "\t")

# Print the first few lines to check the content
head(snp_list)
nrow(snp_list)

snp_list$chr_position <- sub("^(chr[0-9XY]+):([0-9]+):.*", "\\1:\\2", snp_list$ID)
snp_list$formatted_snp <- paste0(
  snp_list$chr_position, 
  "-", 
  as.numeric(sub("^(chr[0-9XY]+):([0-9]+):.*", "\\2", snp_list$ID)) + 1
)

# View the new formatted SNP list
formatted_snp_list <- snp_list[, "formatted_snp"]
head(formatted_snp_list)



# Extract the SNPs into a character vector
test_intervals <- as.character(snp_list$formatted_snp)

# Print the test_intervals 
print(test_intervals)

# formatting 
test_intervals <- paste0("'", test_intervals, "'", collapse = ", ")

# Wrap the entire result in square brackets to create the list format
test_intervals <- paste0("[", test_intervals, "]")

# Print the final formatted output
cat("test_intervals =", test_intervals, "\n")



############################# Without the chr beginning ############################# 

# Read the file as a data frame
snp_list <- read.table("~/Downloads/iPRS-M.txt", header = T, sep = "\t")

# Print the first few lines to check the content
