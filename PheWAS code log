test_intervals <- paste0("[", test_intervals, "]")

# Print the final formatted output
cat("test_intervals =", test_intervals, "\n")


#####need to insert the chr at the start########

# Load the score file
score <- read.table("~/Downloads/iPRS-M.txt", header = T, stringsAsFactors = FALSE)

# Prepend "chr" to the SNP column
score$snp <- paste0("chr", score$snp)

# Check the first few rows
head(score)

# Save the modified file
write.table(score, "iPRS_M_chr.txt", sep = "\t", quote = FALSE, row.names = FALSE)





