############################ Excluding the MHC extended Region from the iPRS #########################################
#### 

#Removing the MHC -slightly extended gene chr6:25726063-33400644

library(dplyr)
library(tidyr)

# Read the data
snp_list <- read.table("~/Downloads/iPRS_M_chr.txt", header = T, sep = "\t")

# Separate the ID column into CHR, POS, REF, ALT
df <- snp_list %>%
  separate(snp, into = c("CHR", "POS", "REF", "ALT"), sep = ":", remove = FALSE) %>%
  mutate(POS = as.numeric(POS))

# Define the region to exclude: chr6 between 28510020 and 33480577
df_filtered <- df %>%
  filter(!(CHR == "chr6" & POS >= 25726063 & POS <= 33400644)) %>%
  select(snp, a1, beta)  # Keep only original columns

# View result
nrow(df_filtered)

# write to file
write.table(df_filtered, "filtered_output_extended_MHCregion.txt", sep = "\t", row.names = FALSE, quote = FALSE)

